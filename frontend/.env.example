# ============================================================
#  oneApplyHub — Frontend Environment Variables
#  Copy this file to .env and fill in any missing values.
#
#  Mac/Linux:  cp .env.example .env
#  Windows:    copy .env.example .env
# ============================================================

# Backend API URL
# Local development:
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Production example:
# REACT_APP_API_BASE_URL=https://oneapplyhub-20-production.up.railway.app/api

# Google OAuth Client ID
# Only needed for the Sign in with Google button.
# Get one from: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=
