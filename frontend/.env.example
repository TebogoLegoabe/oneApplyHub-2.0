# ============================================================
#  oneApplyHub — Frontend Environment Variables
#  Copy this file to .env and fill in any missing values.
#
#  Mac/Linux:  cp .env.example .env
#  Windows:    copy .env.example .env
# ============================================================

# Backend API URL
# Local development:
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Production example:
# REACT_APP_API_BASE_URL=https://oneapplyhub-20-production.up.railway.app/api

# Google OAuth Client ID
# Only needed for the Sign in with Google button.
# Get one from: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# Maps (optional — sensible defaults are built in)
# ------------------------------------------------------------
# Map tiles. Defaults to the OpenStreetMap standard tile server, which is fine for
# normal traffic but may limit heavy commercial use. For production at scale, use a
# commercial OSM tile provider (e.g. MapTiler, Stadia, Thunderforest) or your own.
# REACT_APP_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# REACT_APP_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Exact walking routes (OSRM). Defaults to the free FOSSGIS server used by
# openstreetmap.org (light use only; fetched only when a student clicks).
# Point it at your own OSRM foot-profile server for heavy traffic, or set it to an
# empty value to hide the button (estimates and OSM directions links still work).
# REACT_APP_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
