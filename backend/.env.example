# ============================================================
#  oneApplyHub — Backend Environment Variables
#  Copy this file to .env and fill in any missing values:
#
#  Mac/Linux:  cp .env.example .env
#  Windows:    copy .env.example .env
# ============================================================

# Flask environment — keep as "development" for local work
FLASK_ENV=development

# Secret keys — only required when FLASK_ENV != development
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# ── Database ──────────────────────────────────────────────
# Shared Railway PostgreSQL database (public proxy — works from any machine)
DATABASE_URL=postgresql://postgres:KYDFmzBELVVnNirPDkNjZBQKYNizxszy@hopper.proxy.rlwy.net:35829/railway

# ── Email (optional) ──────────────────────────────────────
# Only needed to actually send verification/reset emails.
# Leave blank to skip email sending during local dev.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@oneapplyhub.co.za

# ── Google OAuth (optional) ───────────────────────────────
# Only needed for the "Sign in with Google" button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Misc (optional) ───────────────────────────────────────
# FRONTEND_URL=http://localhost:3000
# REDIS_URL=redis://localhost:6379/0
