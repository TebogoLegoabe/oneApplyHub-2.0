# ============================================================
#  oneApplyHub — Backend Environment Variables
#  Copy this file to .env and fill in the values you need.
#
#  Mac/Linux:  cp .env.example .env
#  Windows:    copy .env.example .env
# ============================================================

# Flask environment
FLASK_ENV=development

# Secret keys
# Generate your own with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Local Docker PostgreSQL database
# Start it from the project root with:
# docker compose up -d postgres pgadmin
DATABASE_URL=postgresql://oneapplyhub:CHANGE_ME@localhost:5432/oneapplyhub_dev

# Email
# Only needed when you want to send verification and reset emails locally.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@oneapplyhub.co.za

# Google OAuth
# Only needed for the Sign in with Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL used by reset password links and CORS
FRONTEND_URL=http://localhost:3000

# Redis is optional locally. Without this, Flask Limiter uses in memory storage.
# REDIS_URL=redis://localhost:6379/0
