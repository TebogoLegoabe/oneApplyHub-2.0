# Copy this file to .env and adjust values as needed:
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows cmd.exe)
#   Copy-Item .env.example .env (Windows PowerShell)

# "development" relaxes startup validation (see config.py) and falls back to
# insecure default secrets (with a warning) if SECRET_KEY/JWT_SECRET_KEY are
# left blank below. Any other value (or leaving this unset) requires both to
# be set, so use "production" for real deployments.
FLASK_ENV=development

# Required when FLASK_ENV is not "development". Optional for local dev.
# Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Optional - defaults to a local SQLite file (backend/studentstay.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional - only needed to actually send verification/reset emails
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@oneapplyhub.co.za

# Optional - only needed for Google OAuth sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional - used to build links in verification/reset emails
# FRONTEND_URL=http://localhost:3000

# Optional - Redis URL for rate-limit storage; defaults to in-memory (single process only)
# REDIS_URL=redis://localhost:6379/0
